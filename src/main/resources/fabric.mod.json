{
	"schemaVersion": 1,
	"id": "aurelia_transit_architecture",
	"version": "${version}",
	"name": "Aurelia Transit Architecture",
	"description": "A modular European railway and bus-station architecture kit for Minecraft Transit Railway: platforms, signage, furniture, canopies, glazing, catenary and bus-stop pieces.",
	"authors": [
		"Aurelia Transit Architecture contributors"
	],
	"license": "MIT",
	"icon": "assets/aurelia_transit_architecture/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aureliatransit.architecture.AureliaTransitArchitecture"
		],
		"client": [
			"com.aureliatransit.architecture.client.AureliaTransitArchitectureClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": ">=0.92.0",
		"mtr": ">=4.0.0 <5.0.0"
	}
}
